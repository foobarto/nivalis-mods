<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="compatibility-fixtures/**/*.cs" />
    <ProjectReference Include="compatibility-fixtures/Harness/Harness.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../ManagerDemand.cs" Link="ManagerDemand.cs" />
    <Compile Include="../FarmSupplyLedger.cs" Link="FarmSupplyLedger.cs" />
    <Compile Include="../../../shared/managed/SaveSnapshotStore.cs" Link="SaveSnapshotStore.cs" />
    <Compile Include="../../../shared/managed/ManagedApiCompatibility.cs" Link="ManagedApiCompatibility.cs" />
    <Compile Include="../../../shared/managed/ItemTransfer.cs" Link="ItemTransfer.cs" />
    <Compile Include="../../../shared/managed/HarvestRecovery.cs" Link="HarvestRecovery.cs" />
    <Compile Include="../../../shared/managed/HarvestBatch.cs" Link="HarvestBatch.cs" />
    <Compile Include="../../../shared/managed/IdentitySnapshot.cs" Link="IdentitySnapshot.cs" />
  </ItemGroup>
  <Target Name="CopyCompatibilityFixtures" AfterTargets="Build">
    <ItemGroup>
      <CompatibilityFixture Include="$(MSBuildThisFileDirectory)compatibility-fixtures/Harness/bin/$(Configuration)/net10.0/compatibility-fixtures/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(CompatibilityFixture)" DestinationFiles="@(CompatibilityFixture->'$(OutDir)compatibility-fixtures/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
